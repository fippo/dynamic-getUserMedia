{
  "name": "Dynamic GUM errors",
  "description": "change getUserMedia and enumerateDevices results on the fly",
  "author": "Philipp Hancke",
  "version": "1.0.0",
  "manifest_version": 3,
  "minimum_chrome_version": "88",
  "icons": {
  },
  "host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [ {
    "js": [ "content.js" ],
    "run_at": "document_start",
    "matches": [ "https://*/*" ],
    "world": "MAIN"
  }]
}
